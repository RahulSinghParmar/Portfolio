{
  "name": "rahul-singh-parmar-portfolio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality:check": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm run performance:check && npm run seo:check",
    "performance:check": "node scripts/check-performance-budget.mjs",
    "seo:check": "node scripts/check-seo.mjs",
    "deployment:check": "node scripts/check-deployment.mjs"
  },
  "dependencies": {
    "geist": "1.7.2",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  }
}
