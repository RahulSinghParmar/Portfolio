{
  "name": "rahul-singh-parmar-portfolio",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "predev": "npm run content:check",
    "dev": "next dev",
    "content:check": "node scripts/check-content.mjs",
    "test:browser": "node scripts/check-browser.mjs",
    "prebuild": "npm run content:check && node scripts/clean-build-output.mjs",
    "build": "next build",
    "postbuild": "node scripts/prepare-cloudflare-assets.mjs && node scripts/verify-static-export.mjs",
    "start": "node scripts/preview-static.mjs",
    "preview:cloudflare": "npm run build && wrangler dev --local --port 8788",
    "cloudflare:package": "wrangler deploy --dry-run --env preview --outdir .wrangler/dry-run",
    "cloudflare:limits": "node scripts/check-cloudflare-package.mjs",
    "cloudflare:check": "npm run build && npm run cloudflare:package && npm run cloudflare:limits",
    "test:worker": "node --test worker/api-worker.test.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality:check": "npm run format:check && npm run lint && npm run typecheck && npm run test:worker && npm run build && npm run performance:check && npm run seo:check",
    "release:check": "npm run quality:check && npm run cloudflare:package && npm run cloudflare:limits",
    "performance:check": "node scripts/check-performance-budget.mjs",
    "seo:check": "node scripts/check-seo.mjs",
    "deployment:check": "node scripts/check-deployment.mjs",
    "asset:portrait": "node scripts/prepare-portrait.mjs"
  },
  "dependencies": {
    "geist": "1.7.2",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "next": "16.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "ajv": "8.20.0",
    "eslint-config-next": "16.4.5",
    "prettier": "3.9.6",
    "playwright": "1.65.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "wrangler": "4.158.0"
  }
}
