# Public build identity. Safe to expose in the browser.
# These values are frozen during `next build`.
NEXT_PUBLIC_SITE_URL=https://rahulsinghparmar.site
NEXT_PUBLIC_SITE_VERSION=v1.1.0

# API Worker runtime bindings. Never rename these with a NEXT_PUBLIC_ prefix.
# Store SYSTEM_STATUS_TOKEN as a Cloudflare secret, not a plain production variable.
SITE_VERSION=v1.1.0
# Use `disabled` until a read-only JSON endpoint is ready.
SYSTEM_STATUS_SOURCE=disabled
SYSTEM_STATUS_URL=
SYSTEM_STATUS_TOKEN=
SYSTEM_STATUS_TIMEOUT_MS=3500
