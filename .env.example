# Public deployment identity. Safe to expose in the browser.
# These are frozen during `next build`; configure them as Coolify build variables.
NEXT_PUBLIC_SITE_URL=https://rahulsinghparmar.site
NEXT_PUBLIC_SITE_VERSION=v1.0.0

# Server-only runtime status adapter. Never rename these with a NEXT_PUBLIC_ prefix.
# Use `disabled` until a read-only JSON endpoint is ready.
SYSTEM_STATUS_SOURCE=disabled
SYSTEM_STATUS_URL=
SYSTEM_STATUS_TOKEN=
SYSTEM_STATUS_TIMEOUT_MS=3500
