{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rahul-singh-parmar-portfolio-local",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["assets_navigation_has_no_effect"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api", "/api/*"],
  },
  "vars": {
    "DEPLOYMENT_ENV": "local",
    "SITE_VERSION": "v1.0.0-local",
    "SYSTEM_STATUS_SOURCE": "disabled",
    "SYSTEM_STATUS_TIMEOUT_MS": "3500",
  },
  "env": {
    "preview": {
      "name": "rahul-singh-parmar-portfolio-preview",
      "workers_dev": true,
      "preview_urls": true,
      "vars": {
        "DEPLOYMENT_ENV": "preview",
        "SITE_VERSION": "v1.0.0-preview-failure-test",
        "SYSTEM_STATUS_SOURCE": "http",
        "SYSTEM_STATUS_URL": "https://preview-upstream.invalid/status",
        "SYSTEM_STATUS_TIMEOUT_MS": "1000",
      },
    },
    "production": {
      "name": "rahul-singh-parmar-portfolio",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "DEPLOYMENT_ENV": "production",
        "SITE_VERSION": "v1.0.0",
        "SYSTEM_STATUS_SOURCE": "disabled",
        "SYSTEM_STATUS_TIMEOUT_MS": "3500",
      },
    },
  },
}
