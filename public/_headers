# Shared static response policy. Worker-generated API responses set the same
# security policy in worker/security-headers.ts and always remain no-store.
/*
  Cache-Control: public, max-age=0, must-revalidate
  Content-Security-Policy: default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self' data:; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: blob:; manifest-src 'self'; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# Next.js fingerprints files in this directory. These assets may be cached
# permanently because a content change produces a new URL.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The portrait URL is stable, so keep its browser cache bounded and revalidatable.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400

# Preview and workers.dev hostnames must never compete with the canonical domain.
https://:worker.:account.workers.dev/*
  X-Robots-Tag: noindex, nofollow
