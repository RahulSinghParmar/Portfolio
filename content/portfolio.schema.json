{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Portfolio content",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "profile": {
      "description": "Public identity, shared current employment, biography, contact and portrait. Used across the site and generated metadata.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "givenName": {
          "type": "string"
        },
        "familyName": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "employer": {
          "type": "string"
        },
        "headline": {
          "type": "string"
        },
        "statement": {
          "type": "string"
        },
        "introduction": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "experience": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
        },
        "repositoryUrl": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "status": {
          "type": "string"
        },
        "disciplines": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "initials": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "employerShort": {
          "type": "string"
        },
        "heroLabel": {
          "type": "string"
        },
        "nameLines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          }
        },
        "footerNote": {
          "type": "string"
        },
        "portrait": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "src": {
              "type": "string",
              "pattern": "^/images/[a-zA-Z0-9._/-]+\\.(webp|png|jpe?g|avif)$"
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": ["src", "width", "height"]
        },
        "siteUrl": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        }
      },
      "required": [
        "name",
        "givenName",
        "familyName",
        "role",
        "employer",
        "headline",
        "statement",
        "introduction",
        "location",
        "timezone",
        "experience",
        "email",
        "repositoryUrl",
        "status",
        "disciplines",
        "initials",
        "username",
        "employerShort",
        "heroLabel",
        "nameLines",
        "footerNote",
        "portrait",
        "siteUrl"
      ]
    },
    "projects": {
      "description": "Selected work in display order. A title, slug, summary, role, year, technologies and outcome are enough; diagrams and deep dives are optional.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "year": {
            "type": "string"
          },
          "technologies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "challenge": {
            "type": "string"
          },
          "approach": {
            "type": "string"
          },
          "automation": {
            "type": "string"
          },
          "security": {
            "type": "string"
          },
          "observability": {
            "type": "string"
          },
          "outcome": {
            "type": "string"
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": ["value", "label"]
            }
          },
          "architecture": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "nodes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "label": {
                          "type": "string"
                        },
                        "detail": {
                          "type": "string"
                        },
                        "x": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 720
                        },
                        "y": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 340
                        },
                        "align": {
                          "enum": ["start", "middle", "end"]
                        }
                      },
                      "required": ["id", "label", "detail", "x", "y"]
                    }
                  },
                  "routes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "path": {
                          "type": "string"
                        },
                        "label": {
                          "type": "string"
                        },
                        "labelX": {
                          "type": "number"
                        },
                        "labelY": {
                          "type": "number"
                        }
                      },
                      "required": ["id", "path", "label", "labelX", "labelY"]
                    }
                  }
                },
                "required": ["label", "nodes", "routes"]
              },
              {
                "type": "null"
              }
            ]
          },
          "repositoryUrl": {
            "type": ["string", "null"],
            "pattern": "^https://[^\\s]+$"
          },
          "liveUrl": {
            "type": ["string", "null"],
            "pattern": "^https://[^\\s]+$"
          }
        },
        "required": ["slug", "title", "summary", "role", "year", "technologies", "outcome"]
      }
    },
    "experience": {
      "description": "Newest first. One current entry may inherit role, employer and location from profile. Historical entries provide their own facts.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "current": {
            "type": "boolean"
          },
          "period": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "responsibilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "company": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "location": {
            "type": "string"
          }
        },
        "required": ["current", "period", "summary", "responsibilities"],
        "allOf": [
          {
            "if": {
              "properties": {
                "current": {
                  "const": false
                }
              }
            },
            "then": {
              "required": ["company", "role", "location"]
            }
          }
        ]
      }
    },
    "careerDirections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": ["title", "description"]
      }
    },
    "workingModes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": ["label", "title", "description"]
      }
    },
    "skillLayers": {
      "minItems": 1,
      "description": "Capability-map layers. Keep at least one; edit the labels and items freely. Coordinates determine the diagram layout.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "signal": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["index", "id", "label", "description", "signal", "x", "y", "items"]
      }
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "issuer": {
            "type": "string"
          },
          "issued": {
            "type": "string"
          },
          "credentialUrl": {
            "type": ["string", "null"],
            "pattern": "^https://[^\\s]+$"
          }
        },
        "required": ["name", "issuer", "issued", "credentialUrl"]
      }
    },
    "contactChannels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "href": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          },
          "description": {
            "type": "string"
          },
          "identity": {
            "type": "boolean"
          }
        },
        "required": ["label", "value", "href", "description", "identity"]
      }
    },
    "educationHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "degree": {
            "type": "string"
          },
          "discipline": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "institution": {
            "type": "string"
          },
          "period": {
            "type": "string"
          }
        },
        "required": ["degree", "discipline", "note"]
      },
      "minItems": 1
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "socialDescription": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "locale": {
          "type": "string"
        },
        "twitterHandle": {
          "type": "string"
        },
        "contentUpdated": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "description",
        "socialDescription",
        "language",
        "locale",
        "twitterHandle",
        "contentUpdated",
        "keywords"
      ]
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "about": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "eyebrow": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "careerTitle": {
              "type": "string"
            },
            "educationMark": {
              "type": "string"
            }
          },
          "required": ["eyebrow", "title", "careerTitle", "educationMark"]
        },
        "work": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          },
          "required": ["title", "description"]
        }
      },
      "required": ["about", "work"]
    }
  },
  "required": [
    "$schema",
    "profile",
    "projects",
    "experience",
    "careerDirections",
    "workingModes",
    "skillLayers",
    "certifications",
    "contactChannels",
    "educationHistory",
    "seo",
    "sections"
  ]
}
